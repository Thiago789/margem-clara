NODE_ENV=development
PORT=3333
SERVICE_NAME=margem-clara-api
POSTGRES_DB=margem_clara
POSTGRES_USER=margem_clara
POSTGRES_PASSWORD=generate-a-long-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://margem_clara:generate-a-long-local-password@localhost:5432/margem_clara?schema=public
AUTH_LOOKUP_SECRET=generate-an-independent-random-secret-with-at-least-32-characters
SESSION_TTL_SECONDS=28800
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_MAX_FAILURES_PER_EMAIL=5
AUTH_MAX_FAILURES_PER_IP=20
LOG_LEVEL=info
TRUST_PROXY=false
