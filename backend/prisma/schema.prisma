generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVOKED
}

enum PartyType {
  FINANCIAL_INSTITUTION
  HEALTH_PLAN
  INSURER
  PENSION_PROVIDER
  ASSOCIATION
  UNION
  COOPERATIVE
  COMMERCE
  SERVICE_PROVIDER
  LAW_OFFICE
  OTHER
}

enum ProductFamily {
  PAYROLL_LOAN
  PAYROLL_CARD
  BENEFIT_CARD
  OPTIONAL_DEDUCTION
}

enum ChargeMode {
  FIXED_INSTALLMENTS
  INDEFINITE_RECURRING
  PERCENTAGE
  VARIABLE_BY_COMPETENCY
  OCCASIONAL
  SINGLE_CHARGE
  RESERVED_LIMIT
}

enum AccreditationStatus {
  PENDING
  HOMOLOGATION
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum EnvironmentKind {
  HOMOLOGATION
  PRODUCTION
}

enum AuthAttemptOutcome {
  SUCCESS
  FAILURE
  BLOCKED
}

enum PayrollCycleStatus {
  OPEN
  REVIEW
  PUBLISHED
  CLOSED
}

enum PayrollFileType {
  MARGIN
  INSERTION
  RETURN
}

enum PayrollFileDirection {
  INBOUND
  OUTBOUND
}

enum PayrollFileStatus {
  RECEIVED
  VALIDATED
  REJECTED
  PROCESSING
  APPLIED
}

enum PayrollFileRowStatus {
  VALID
  INVALID
  APPLIED
}

enum PayrollInstructionStatus {
  GENERATED
  RECONCILED
}

enum PayrollDiscountOutcome {
  FULL
  PARTIAL
  REJECTED
}

enum PayrollExceptionStatus {
  OPEN
  IN_REVIEW
}

enum MarginMovementType {
  RECALCULATION
  RESERVATION
  RELEASE
  CONSUMPTION
  BLOCK
  UNBLOCK
  REVERSAL
}

enum MarginMovementDirection {
  INCREASE
  DECREASE
  NO_CHANGE
}

enum MarginReservationStatus {
  PENDING_CONFIRMATION
  ACTIVE
  CANCELLED
  EXPIRED
  CONVERTED
}

enum ReservationConfirmationMode {
  CODE_REQUIRED
  IMMEDIATE
}

enum ContractOperationType {
  NEW
  REFINANCING
  PORTABILITY
  DEBT_PURCHASE
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
  SETTLED
  CANCELLED
}

model Organization {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  documentNumber String       @unique @map("document_number")
  type           String
  status         RecordStatus @default(ACTIVE)
  agreements     Agreement[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int          @default(1)

  @@map("organizations")
}

model Agreement {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @map("organization_id") @db.Uuid
  organization          Organization                @relation(fields: [organizationId], references: [id])
  tenantKey             String                      @unique @map("tenant_key")
  code                  String
  name                  String
  timezone              String                      @default("America/Fortaleza")
  payrollFrequency      String                      @default("monthly") @map("payroll_frequency")
  dataClassification    String                      @default("confidential") @map("data_classification")
  status                RecordStatus                @default(ACTIVE)
  policies              AgreementPolicyVersion[]
  accreditations        Accreditation[]
  enrollments           Enrollment[]
  memberships           Membership[]
  auditEvents           AuditEvent[]
  outboxEvents          OutboxEvent[]
  payrollCycles         PayrollCycle[]
  payrollFiles          PayrollFile[]
  payrollFileRows       PayrollFileRow[]
  payrollSnapshots      EnrollmentPayrollSnapshot[]
  marginGroups          MarginGroup[]
  marginAccounts        MarginAccount[]
  marginSnapshots       MarginSnapshot[]
  marginMovements       MarginMovement[]
  marginReservations    MarginReservation[]
  contracts             Contract[]
  payrollInstructions   PayrollInstruction[]
  payrollDiscountEvents PayrollDiscountEvent[]
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  version               Int                         @default(1)

  @@unique([organizationId, code])
  @@map("agreements")
}

model AgreementPolicyVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  agreementId        String              @map("agreement_id") @db.Uuid
  agreement          Agreement           @relation(fields: [agreementId], references: [id])
  policyType         String              @map("policy_type")
  versionNumber      Int                 @map("version_number")
  payload            Json
  validFrom          DateTime            @map("valid_from") @db.Timestamptz(6)
  validUntil         DateTime?           @map("valid_until") @db.Timestamptz(6)
  status             PolicyStatus        @default(DRAFT)
  approvedByUserId   String?             @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  payrollCycles      PayrollCycle[]
  marginSnapshots    MarginSnapshot[]
  marginReservations MarginReservation[]
  contracts          Contract[]

  @@unique([agreementId, policyType, versionNumber])
  @@index([agreementId, policyType, status])
  @@map("agreement_policy_versions")
}

model Party {
  id                   String              @id @default(uuid()) @db.Uuid
  legalName            String              @map("legal_name")
  tradeName            String?             @map("trade_name")
  documentNumber       String              @unique @map("document_number")
  partyType            PartyType           @map("party_type")
  regulatoryIdentifier String?             @map("regulatory_identifier")
  status               RecordStatus        @default(ACTIVE)
  contactEmail         String?             @map("contact_email")
  contactPhone         String?             @map("contact_phone")
  metadata             Json?
  accreditations       Accreditation[]
  memberships          Membership[]
  marginReservations   MarginReservation[]
  contracts            Contract[]
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int                 @default(1)

  @@map("parties")
}

model Product {
  id                     String              @id @default(uuid()) @db.Uuid
  code                   String              @unique
  name                   String
  family                 ProductFamily
  chargeMode             ChargeMode          @map("charge_mode")
  requiresCreditContract Boolean             @default(false) @map("requires_credit_contract")
  requiresConsent        Boolean             @default(true) @map("requires_consent")
  supportsVariableAmount Boolean             @default(false) @map("supports_variable_amount")
  status                 RecordStatus        @default(ACTIVE)
  accreditations         Accreditation[]
  marginReservations     MarginReservation[]
  contracts              Contract[]
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("products")
}

model Accreditation {
  id                 String              @id @default(uuid()) @db.Uuid
  agreementId        String              @map("agreement_id") @db.Uuid
  agreement          Agreement           @relation(fields: [agreementId], references: [id])
  partyId            String              @map("party_id") @db.Uuid
  party              Party               @relation(fields: [partyId], references: [id])
  productId          String              @map("product_id") @db.Uuid
  product            Product             @relation(fields: [productId], references: [id])
  status             AccreditationStatus @default(PENDING)
  environment        EnvironmentKind     @default(HOMOLOGATION)
  integrationMode    String              @default("manual") @map("integration_mode")
  operationalLimit   Decimal?            @map("operational_limit") @db.Decimal(18, 2)
  validFrom          DateTime            @map("valid_from") @db.Timestamptz(6)
  validUntil         DateTime?           @map("valid_until") @db.Timestamptz(6)
  approvedByUserId   String?             @map("approved_by_user_id") @db.Uuid
  suspensionReason   String?             @map("suspension_reason")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                 @default(1)
  marginReservations MarginReservation[]
  contracts          Contract[]

  @@unique([agreementId, partyId, productId, environment, validFrom])
  @@index([agreementId, partyId, status])
  @@map("accreditations")
}

model Person {
  id             String       @id @default(uuid()) @db.Uuid
  fullName       String       @map("full_name")
  socialName     String?      @map("social_name")
  cpfEncrypted   String       @map("cpf_encrypted")
  cpfLookupHash  String       @unique @map("cpf_lookup_hash")
  birthDate      DateTime     @map("birth_date") @db.Date
  emailEncrypted String?      @map("email_encrypted")
  phoneEncrypted String?      @map("phone_encrypted")
  status         RecordStatus @default(ACTIVE)
  enrollments    Enrollment[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int          @default(1)

  @@map("people")
}

model Enrollment {
  id                        String                      @id @default(uuid()) @db.Uuid
  agreementId               String                      @map("agreement_id") @db.Uuid
  agreement                 Agreement                   @relation(fields: [agreementId], references: [id])
  personId                  String                      @map("person_id") @db.Uuid
  person                    Person                      @relation(fields: [personId], references: [id])
  enrollmentNumberEncrypted String                      @map("enrollment_number_encrypted")
  enrollmentLookupKey       String                      @map("enrollment_lookup_key")
  functionalStatus          String                      @map("functional_status")
  employmentType            String?                     @map("employment_type")
  admissionDate             DateTime?                   @map("admission_date") @db.Date
  terminationDate           DateTime?                   @map("termination_date") @db.Date
  payrollGroup              String?                     @map("payroll_group")
  department                String?
  costCenter                String?                     @map("cost_center")
  baseSalary                Decimal                     @default(0) @map("base_salary") @db.Decimal(18, 2)
  mandatoryDeductions       Decimal                     @default(0) @map("mandatory_deductions") @db.Decimal(18, 2)
  marginBase                Decimal                     @default(0) @map("margin_base") @db.Decimal(18, 2)
  sourceUpdatedAt           DateTime?                   @map("source_updated_at") @db.Timestamptz(6)
  status                    RecordStatus                @default(ACTIVE)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                   Int                         @default(1)
  payrollFileRows           PayrollFileRow[]
  payrollSnapshots          EnrollmentPayrollSnapshot[]
  marginAccounts            MarginAccount[]
  marginSnapshots           MarginSnapshot[]
  marginMovements           MarginMovement[]
  marginReservations        MarginReservation[]
  contracts                 Contract[]
  payrollInstructions       PayrollInstruction[]
  payrollDiscountEvents     PayrollDiscountEvent[]

  @@unique([agreementId, enrollmentLookupKey])
  @@index([agreementId, personId, status])
  @@map("enrollments")
}

model PayrollCycle {
  id              String                      @id @default(uuid()) @db.Uuid
  agreementId     String                      @map("agreement_id") @db.Uuid
  agreement       Agreement                   @relation(fields: [agreementId], references: [id])
  competency      DateTime                    @db.Date
  cutoffAt        DateTime                    @map("cutoff_at") @db.Timestamptz(6)
  insertionDueAt  DateTime?                   @map("insertion_due_at") @db.Timestamptz(6)
  returnDueAt     DateTime?                   @map("return_due_at") @db.Timestamptz(6)
  status          PayrollCycleStatus          @default(OPEN)
  policyVersionId String?                     @map("policy_version_id") @db.Uuid
  policyVersion   AgreementPolicyVersion?     @relation(fields: [policyVersionId], references: [id])
  closedByUserId  String?                     @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime?                   @map("closed_at") @db.Timestamptz(6)
  files           PayrollFile[]
  snapshots       EnrollmentPayrollSnapshot[]
  marginSnapshots MarginSnapshot[]
  instructions    PayrollInstruction[]
  discountEvents  PayrollDiscountEvent[]
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int                         @default(1)

  @@unique([agreementId, competency])
  @@index([agreementId, status])
  @@map("payroll_cycles")
}

model PayrollFile {
  id                String               @id @default(uuid()) @db.Uuid
  agreementId       String               @map("agreement_id") @db.Uuid
  agreement         Agreement            @relation(fields: [agreementId], references: [id])
  payrollCycleId    String               @map("payroll_cycle_id") @db.Uuid
  payrollCycle      PayrollCycle         @relation(fields: [payrollCycleId], references: [id])
  fileType          PayrollFileType      @map("file_type")
  direction         PayrollFileDirection
  environment       EnvironmentKind
  layoutVersion     String               @map("layout_version")
  protocolNumber    String               @map("protocol_number")
  originalFileName  String               @map("original_file_name")
  contentHash       String               @map("content_hash")
  sizeBytes         BigInt               @map("size_bytes")
  mediaType         String               @map("media_type")
  status            PayrollFileStatus    @default(RECEIVED)
  totalRows         Int                  @default(0) @map("total_rows")
  validRows         Int                  @default(0) @map("valid_rows")
  invalidRows       Int                  @default(0) @map("invalid_rows")
  totalAmount       Decimal              @default(0) @map("total_amount") @db.Decimal(18, 2)
  idempotencyKey    String               @map("idempotency_key")
  uploadedByUserId  String               @map("uploaded_by_user_id") @db.Uuid
  processedByUserId String?              @map("processed_by_user_id") @db.Uuid
  rows              PayrollFileRow[]
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt       DateTime?            @map("processed_at") @db.Timestamptz(6)

  @@unique([agreementId, protocolNumber])
  @@unique([agreementId, idempotencyKey])
  @@unique([agreementId, payrollCycleId, fileType, contentHash], map: "payroll_files_cycle_type_hash_key")
  @@index([agreementId, payrollCycleId, status])
  @@map("payroll_files")
}

model PayrollFileRow {
  id                    String                     @id @default(uuid()) @db.Uuid
  agreementId           String                     @map("agreement_id") @db.Uuid
  agreement             Agreement                  @relation(fields: [agreementId], references: [id])
  payrollFileId         String                     @map("payroll_file_id") @db.Uuid
  payrollFile           PayrollFile                @relation(fields: [payrollFileId], references: [id])
  rowNumber             Int                        @map("row_number")
  enrollmentId          String?                    @map("enrollment_id") @db.Uuid
  enrollment            Enrollment?                @relation(fields: [enrollmentId], references: [id])
  externalReferenceHash String?                    @map("external_reference_hash")
  amount                Decimal?                   @db.Decimal(18, 2)
  status                PayrollFileRowStatus
  rawDataEncrypted      String                     @map("raw_data_encrypted")
  normalizedData        Json?                      @map("normalized_data")
  errors                Json
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  payrollSnapshot       EnrollmentPayrollSnapshot?
  payrollInstruction    PayrollInstruction?        @relation("InstructionSourceRow")
  discountEvent         PayrollDiscountEvent?      @relation("DiscountReturnSourceRow")

  @@unique([payrollFileId, rowNumber])
  @@index([agreementId, enrollmentId, status])
  @@map("payroll_file_rows")
}

model EnrollmentPayrollSnapshot {
  id              String         @id @default(uuid()) @db.Uuid
  agreementId     String         @map("agreement_id") @db.Uuid
  agreement       Agreement      @relation(fields: [agreementId], references: [id])
  payrollCycleId  String         @map("payroll_cycle_id") @db.Uuid
  payrollCycle    PayrollCycle   @relation(fields: [payrollCycleId], references: [id])
  enrollmentId    String         @map("enrollment_id") @db.Uuid
  enrollment      Enrollment     @relation(fields: [enrollmentId], references: [id])
  sourceFileRowId String         @unique @map("source_file_row_id") @db.Uuid
  sourceFileRow   PayrollFileRow @relation(fields: [sourceFileRowId], references: [id])
  beforeData      Json           @map("before_data")
  afterData       Json           @map("after_data")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([payrollCycleId, enrollmentId])
  @@index([agreementId, enrollmentId, createdAt], map: "enrollment_payroll_snapshots_lookup_idx")
  @@map("enrollment_payroll_snapshots")
}

model PayrollInstruction {
  id                String                   @id @default(uuid()) @db.Uuid
  agreementId       String                   @map("agreement_id") @db.Uuid
  agreement         Agreement                @relation(fields: [agreementId], references: [id])
  payrollCycleId    String                   @map("payroll_cycle_id") @db.Uuid
  payrollCycle      PayrollCycle             @relation(fields: [payrollCycleId], references: [id])
  contractId        String                   @map("contract_id") @db.Uuid
  contract          Contract                 @relation(fields: [contractId], references: [id])
  enrollmentId      String                   @map("enrollment_id") @db.Uuid
  enrollment        Enrollment               @relation(fields: [enrollmentId], references: [id])
  sourceFileRowId   String                   @unique @map("source_file_row_id") @db.Uuid
  sourceFileRow     PayrollFileRow           @relation("InstructionSourceRow", fields: [sourceFileRowId], references: [id])
  installmentNumber Int?                     @map("installment_number")
  amount            Decimal                  @db.Decimal(18, 2)
  status            PayrollInstructionStatus @default(GENERATED)
  discountEvent     PayrollDiscountEvent?
  reconciledAt      DateTime?                @map("reconciled_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([payrollCycleId, contractId], map: "payroll_instruction…855 tokens truncated…    @relation(fields: [agreementId], references: [id])
  enrollmentId      String              @map("enrollment_id") @db.Uuid
  enrollment        Enrollment          @relation(fields: [enrollmentId], references: [id])
  marginGroupId     String              @map("margin_group_id") @db.Uuid
  marginGroup       MarginGroup         @relation(fields: [marginGroupId], references: [id])
  currentSnapshotId String?             @unique @map("current_snapshot_id") @db.Uuid
  currentSnapshot   MarginSnapshot?     @relation("CurrentMarginSnapshot", fields: [currentSnapshotId], references: [id])
  totalAmount       Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  consumedAmount    Decimal             @default(0) @map("consumed_amount") @db.Decimal(18, 2)
  reservedAmount    Decimal             @default(0) @map("reserved_amount") @db.Decimal(18, 2)
  blockedAmount     Decimal             @default(0) @map("blocked_amount") @db.Decimal(18, 2)
  availableAmount   Decimal             @default(0) @map("available_amount") @db.Decimal(18, 2)
  status            RecordStatus        @default(ACTIVE)
  lockVersion       Int                 @default(1) @map("lock_version")
  snapshots         MarginSnapshot[]    @relation("AccountSnapshots")
  movements         MarginMovement[]
  reservations      MarginReservation[]
  contracts         Contract[]
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([agreementId, enrollmentId, marginGroupId])
  @@index([agreementId, enrollmentId, status])
  @@map("margin_accounts")
}

model MarginSnapshot {
  id                 String                 @id @default(uuid()) @db.Uuid
  agreementId        String                 @map("agreement_id") @db.Uuid
  agreement          Agreement              @relation(fields: [agreementId], references: [id])
  payrollCycleId     String                 @map("payroll_cycle_id") @db.Uuid
  payrollCycle       PayrollCycle           @relation(fields: [payrollCycleId], references: [id])
  enrollmentId       String                 @map("enrollment_id") @db.Uuid
  enrollment         Enrollment             @relation(fields: [enrollmentId], references: [id])
  marginGroupId      String                 @map("margin_group_id") @db.Uuid
  marginGroup        MarginGroup            @relation(fields: [marginGroupId], references: [id])
  marginAccountId    String                 @map("margin_account_id") @db.Uuid
  marginAccount      MarginAccount          @relation("AccountSnapshots", fields: [marginAccountId], references: [id])
  currentForAccount  MarginAccount?         @relation("CurrentMarginSnapshot")
  policyVersionId    String                 @map("policy_version_id") @db.Uuid
  policyVersion      AgreementPolicyVersion @relation(fields: [policyVersionId], references: [id])
  calculationBase    Decimal                @map("calculation_base") @db.Decimal(18, 2)
  percentage         Decimal                @db.Decimal(7, 4)
  totalAmount        Decimal                @map("total_amount") @db.Decimal(18, 2)
  consumedAmount     Decimal                @map("consumed_amount") @db.Decimal(18, 2)
  reservedAmount     Decimal                @map("reserved_amount") @db.Decimal(18, 2)
  blockedAmount      Decimal                @map("blocked_amount") @db.Decimal(18, 2)
  availableAmount    Decimal                @map("available_amount") @db.Decimal(18, 2)
  calculationVersion Int                    @map("calculation_version")
  explanation        Json
  publishedAt        DateTime               @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([payrollCycleId, enrollmentId, marginGroupId], map: "margin_snapshots_cycle_enrollment_group_key")
  @@index([agreementId, enrollmentId, createdAt])
  @@map("margin_snapshots")
}

model MarginMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  agreementId     String                  @map("agreement_id") @db.Uuid
  agreement       Agreement               @relation(fields: [agreementId], references: [id])
  marginAccountId String                  @map("margin_account_id") @db.Uuid
  marginAccount   MarginAccount           @relation(fields: [marginAccountId], references: [id])
  enrollmentId    String                  @map("enrollment_id") @db.Uuid
  enrollment      Enrollment              @relation(fields: [enrollmentId], references: [id])
  movementType    MarginMovementType      @map("movement_type")
  direction       MarginMovementDirection
  amount          Decimal                 @db.Decimal(18, 2)
  balanceBefore   Decimal                 @map("balance_before") @db.Decimal(18, 2)
  balanceAfter    Decimal                 @map("balance_after") @db.Decimal(18, 2)
  sourceType      String                  @map("source_type")
  sourceId        String                  @map("source_id") @db.Uuid
  idempotencyKey  String                  @map("idempotency_key")
  correlationId   String                  @map("correlation_id") @db.Uuid
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  reason          String
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([agreementId, idempotencyKey])
  @@index([agreementId, marginAccountId, createdAt])
  @@map("margin_movements")
}

model MarginReservation {
  id                    String                      @id @default(uuid()) @db.Uuid
  agreementId           String                      @map("agreement_id") @db.Uuid
  agreement             Agreement                   @relation(fields: [agreementId], references: [id])
  partyId               String                      @map("party_id") @db.Uuid
  party                 Party                       @relation(fields: [partyId], references: [id])
  accreditationId       String                      @map("accreditation_id") @db.Uuid
  accreditation         Accreditation               @relation(fields: [accreditationId], references: [id])
  productId             String                      @map("product_id") @db.Uuid
  product               Product                     @relation(fields: [productId], references: [id])
  enrollmentId          String                      @map("enrollment_id") @db.Uuid
  enrollment            Enrollment                  @relation(fields: [enrollmentId], references: [id])
  marginAccountId       String                      @map("margin_account_id") @db.Uuid
  marginAccount         MarginAccount               @relation(fields: [marginAccountId], references: [id])
  policyVersionId       String                      @map("policy_version_id") @db.Uuid
  policyVersion         AgreementPolicyVersion      @relation(fields: [policyVersionId], references: [id])
  amount                Decimal                     @db.Decimal(18, 2)
  status                MarginReservationStatus
  confirmationMode      ReservationConfirmationMode @map("confirmation_mode")
  confirmationCodeHash  String?                     @map("confirmation_code_hash")
  confirmationExpiresAt DateTime?                   @map("confirmation_expires_at") @db.Timestamptz(6)
  confirmationAttempts  Int                         @default(0) @map("confirmation_attempts")
  expiresAt             DateTime?                   @map("expires_at") @db.Timestamptz(6)
  confirmedAt           DateTime?                   @map("confirmed_at") @db.Timestamptz(6)
  confirmedByUserId     String?                     @map("confirmed_by_user_id") @db.Uuid
  confirmedBy           User?                       @relation("ReservationConfirmedBy", fields: [confirmedByUserId], references: [id])
  cancelledAt           DateTime?                   @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId     String?                     @map("cancelled_by_user_id") @db.Uuid
  cancelledBy           User?                       @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason    String?                     @map("cancellation_reason")
  expiredAt             DateTime?                   @map("expired_at") @db.Timestamptz(6)
  convertedAt           DateTime?                   @map("converted_at") @db.Timestamptz(6)
  contract              Contract?
  idempotencyKey        String                      @map("idempotency_key")
  externalReference     String?                     @map("external_reference")
  createdByUserId       String                      @map("created_by_user_id") @db.Uuid
  createdBy             User                        @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  lockVersion           Int                         @default(1) @map("lock_version")

  @@unique([agreementId, idempotencyKey], map: "margin_reservations_idempotency_key")
  @@index([agreementId, partyId, status, createdAt], map: "margin_reservations_party_status_idx")
  @@index([marginAccountId, status, expiresAt], map: "margin_reservations_account_status_idx")
  @@map("margin_reservations")
}

model Contract {
  id                      String                 @id @default(uuid()) @db.Uuid
  agreementId             String                 @map("agreement_id") @db.Uuid
  agreement               Agreement              @relation(fields: [agreementId], references: [id])
  partyId                 String                 @map("party_id") @db.Uuid
  party                   Party                  @relation(fields: [partyId], references: [id])
  accreditationId         String                 @map("accreditation_id") @db.Uuid
  accreditation           Accreditation          @relation(fields: [accreditationId], references: [id])
  productId               String                 @map("product_id") @db.Uuid
  product                 Product                @relation(fields: [productId], references: [id])
  enrollmentId            String                 @map("enrollment_id") @db.Uuid
  enrollment              Enrollment             @relation(fields: [enrollmentId], references: [id])
  marginAccountId         String                 @map("margin_account_id") @db.Uuid
  marginAccount           MarginAccount          @relation(fields: [marginAccountId], references: [id])
  policyVersionId         String                 @map("policy_version_id") @db.Uuid
  policyVersion           AgreementPolicyVersion @relation(fields: [policyVersionId], references: [id])
  reservationId           String                 @unique @map("reservation_id") @db.Uuid
  reservation             MarginReservation      @relation(fields: [reservationId], references: [id])
  contractNumber          String                 @map("contract_number")
  operationType           ContractOperationType  @map("operation_type")
  status                  ContractStatus         @default(ACTIVE)
  contractValue           Decimal?               @map("contract_value") @db.Decimal(18, 2)
  installmentAmount       Decimal                @map("installment_amount") @db.Decimal(18, 2)
  termInstallments        Int?                   @map("term_installments")
  currentInstallment      Int                    @default(0) @map("current_installment")
  cetAnnual               Decimal?               @map("cet_annual") @db.Decimal(9, 6)
  cetMonthly              Decimal?               @map("cet_monthly") @db.Decimal(9, 6)
  firstDueDate            DateTime?              @map("first_due_date") @db.Date
  firstCompetency         DateTime?              @map("first_competency") @db.Date
  outstandingBalance      Decimal?               @map("outstanding_balance") @db.Decimal(18, 2)
  originContractReference String?                @map("origin_contract_reference")
  originCreditorName      String?                @map("origin_creditor_name")
  debtPurchaseAmount      Decimal?               @map("debt_purchase_amount") @db.Decimal(18, 2)
  externalReference       String?                @map("external_reference")
  idempotencyKey          String                 @map("idempotency_key")
  activatedAt             DateTime               @map("activated_at") @db.Timestamptz(6)
  suspendedAt             DateTime?              @map("suspended_at") @db.Timestamptz(6)
  settledAt               DateTime?              @map("settled_at") @db.Timestamptz(6)
  cancelledAt             DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  createdByUserId         String                 @map("created_by_user_id") @db.Uuid
  createdBy               User                   @relation("ContractCreatedBy", fields: [createdByUserId], references: [id])
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int                    @default(1)
  payrollInstructions     PayrollInstruction[]
  payrollDiscountEvents   PayrollDiscountEvent[]

  @@unique([agreementId, idempotencyKey], map: "contracts_idempotency_key")
  @@unique([agreementId, partyId, contractNumber], map: "contracts_party_number_key")
  @@index([agreementId, partyId, status, createdAt], map: "contracts_party_status_idx")
  @@index([marginAccountId, status], map: "contracts_margin_account_status_idx")
  @@index([enrollmentId, status], map: "contracts_enrollment_status_idx")
  @@map("contracts")
}

model User {
  id                            String                 @id @default(uuid()) @db.Uuid
  name                          String
  email                         String                 @unique
  passwordHash                  String                 @map("password_hash")
  status                        RecordStatus           @default(ACTIVE)
  lastLoginAt                   DateTime?              @map("last_login_at") @db.Timestamptz(6)
  memberships                   Membership[]
  authSessions                  AuthSession[]
  authAttempts                  AuthAttempt[]
  createdReservations           MarginReservation[]    @relation("ReservationCreatedBy")
  confirmedReservations         MarginReservation[]    @relation("ReservationConfirmedBy")
  cancelledReservations         MarginReservation[]    @relation("ReservationCancelledBy")
  createdContracts              Contract[]             @relation("ContractCreatedBy")
  acknowledgedPayrollExceptions PayrollDiscountEvent[] @relation("PayrollExceptionAcknowledgedBy")
  createdAt                     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                       Int                    @default(1)

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthAttempt {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String?            @map("user_id") @db.Uuid
  user            User?              @relation(fields: [userId], references: [id])
  emailLookupHash String             @map("email_lookup_hash")
  ipLookupHash    String             @map("ip_lookup_hash")
  outcome         AuthAttemptOutcome
  occurredAt      DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([emailLookupHash, occurredAt])
  @@index([ipLookupHash, occurredAt])
  @@map("auth_attempts")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  permissions RolePermission[]
  memberships Membership[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id])
  roleId      String       @map("role_id") @db.Uuid
  role        Role         @relation(fields: [roleId], references: [id])
  agreementId String?      @map("agreement_id") @db.Uuid
  agreement   Agreement?   @relation(fields: [agreementId], references: [id])
  partyId     String?      @map("party_id") @db.Uuid
  party       Party?       @relation(fields: [partyId], references: [id])
  status      RecordStatus @default(ACTIVE)
  validFrom   DateTime     @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agreementId, userId, status])
  @@index([partyId, userId, status])
  @@map("memberships")
}

model AuditEvent {
  id            String     @id @default(uuid()) @db.Uuid
  agreementId   String?    @map("agreement_id") @db.Uuid
  agreement     Agreement? @relation(fields: [agreementId], references: [id])
  actorUserId   String?    @map("actor_user_id") @db.Uuid
  actorRole     String?    @map("actor_role")
  actorPartyId  String?    @map("actor_party_id") @db.Uuid
  action        String
  outcome       String
  entityType    String     @map("entity_type")
  entityId      String?    @map("entity_id")
  correlationId String     @map("correlation_id") @db.Uuid
  requestId     String?    @map("request_id")
  previousData  Json?      @map("previous_data")
  newData       Json?      @map("new_data")
  reason        String?
  ipAddress     String?    @map("ip_address")
  userAgent     String?    @map("user_agent")
  occurredAt    DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([agreementId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  agreementId   String    @map("agreement_id") @db.Uuid
  agreement     Agreement @relation(fields: [agreementId], references: [id])
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  correlationId String    @map("correlation_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  status        String    @default("pending")

  @@index([status, occurredAt])
  @@index([agreementId, aggregateType, aggregateId])
  @@map("outbox_events")
}

